# Copy to .env.local for local development. On Hostinger, set these in hPanel.
# Every key is described in src/lib/env.ts. Missing keys never crash the app.

# --- Core (required) ---
# Local Docker MySQL: docker compose -f docker/dev.yml up -d
DATABASE_URL=mysql://ingotkit:ingotkit@127.0.0.1:3306/ingotkit
APP_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Social sign-in (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email via SMTP ---
# Local defaults point at Mailpit from docker/dev.yml (inbox: http://localhost:8025).
# On Hostinger: smtp.hostinger.com, port 465, your mailbox address and password.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="IngotKit <hello@localhost>"

# --- Payments (Phase 3) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Text AI (Phase 4) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Image and video AI (Phase 4) ---
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# --- Media storage, S3-compatible such as Cloudflare R2 (optional) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Background jobs: hPanel cron calls /api/cron/* with this secret ---
CRON_SECRET=
